PORT=8095
HOST=127.0.0.1
DATA_DIR=./data

# AI Coach Settings
# Multi-layered nested adapter: switch models cleanly here without touching application code.
COACH_PROVIDER=gemini-api
COACH_MODEL=gemini-2.5-flash
# Alternative provider options:
# COACH_PROVIDER=agy-cli
# COACH_PROVIDER=rule-fallback

# KataGo Settings (Homebrew Metal on Mac mini)
KATAGO_PATH=/opt/homebrew/bin/katago
KATAGO_MODEL=/opt/homebrew/share/katago/kata1-b18c384nbt-s9996604416-d4316597426.bin.gz
KATAGO_MAX_VISITS=150
KATAGO_THREADS=2
KATAGO_MAX_BATCH_SIZE=16

# Security & Tailscale
ALLOWED_ORIGINS=http://127.0.0.1:8095,http://localhost:8095
