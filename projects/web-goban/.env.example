# Web Goban environment configuration
# Copy this file to .env and customize for your environment.

# Comma-separated allowed origins for CORS and WebSocket Origin verification (* is forbidden)
ALLOWED_ORIGINS=http://127.0.0.1:8090,http://localhost:8090
# Example for Tailscale HTTPS PWA + future Android WebView wrapper:
# ALLOWED_ORIGINS=http://127.0.0.1:8090,http://localhost:8090,https://mac-mini.<tailnet>.ts.net,https://appassets.androidplatform.net

# KataGo Analysis Engine paths
KATAGO_BIN=/opt/homebrew/bin/katago
KATAGO_MODEL=/opt/homebrew/share/katago/kata1-b18c384nbt-s9996604416-d4316597426.bin.gz
KATAGO_CONFIG=config/katago_analysis.cfg

# Seconds of inactivity before KataGo automatically stops to free unified memory
KATAGO_IDLE_TIMEOUT_SEC=900

# Uvicorn bind host and port (use 127.0.0.1 behind tailscale serve)
WEB_GOBAN_HOST=127.0.0.1
WEB_GOBAN_PORT=8090
